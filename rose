    return p


def main(argv):
    global LOADED_STAMP
    LOADED_STAMP = code_stamp()
    try:
        c = argv[0] if argv else ''
        if c in TOOLS + ('chat', 'resume', ''):
            with contextlib.suppress(Exception):
                background_check()   # cheap: local git refs; the fetch runs detached
        if not argv:
            return menu() if sys.stdin.isatty() else parser().print_help()
        if c in TOOLS:
            return run_tool(c, argv[1:])
        if c == 'resume':
            return resume_cmd(argv[1:])
        if c == 'chat':
            return cmd_chat(argv[1:])
        if c == 'failover':
            return cmd_failover(argv[1:])
        if c == 'statusline':
            return cmd_statusline(argv[1:])
        if c == 'hook':
            return cmd_hook(argv[1:])
        if c == '__continue':
            return cmd_continue(argv[1:])
        if c == '__emit':
            return emit(argv[1:])
        if c in ('use', 'off'):
            raise Error(f"'rose {c}' changes your shell; add to ~/.bashrc: eval \"$(rose init bash)\"")
        a = parser().parse_args(argv)
        return a.fn(a)
    except Error as e:
        print('rose: ' + str(e), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print()
        return 130


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]) or 0)
