# ---------------------------------------------------------------- storage

def private_dir(path):
    path.mkdir(parents=True, exist_ok=True)
    with contextlib.suppress(OSError):
        path.chmod(0o700)
    return path


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def atomic_json(path, data):
    private_dir(path.parent)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix='.tmp-')
    with os.fdopen(fd, 'w') as f:
        json.dump(data, f, indent=2, sort_keys=True)
    os.replace(tmp, path)


@contextlib.contextmanager
def lock(name):
    private_dir(ROOT / 'locks')
    with open(ROOT / 'locks' / (name + '.lock'), 'a') as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def settings():
    s = read_json(ROOT / 'settings.json', {})
    s.setdefault('failover', {'claude': 'ask', 'codex': 'ask'})
    s.setdefault('defaults', {})
    return s


def save_settings(s):
    with lock('settings'):
        atomic_json(ROOT / 'settings.json', s)


def record(event, **fields):
    fields.update(event=event, time=dt.datetime.now().astimezone().isoformat(timespec='seconds'))
    private_dir(ROOT)
    with open(ROOT / 'activity.jsonl', 'a') as f:
        f.write(json.dumps(fields) + '\n')


def owners():
    return read_json(ROOT / 'owners.json', {})


def set_owner(tool, sid, name):
    with lock('owners'):
        o = owners()
        o[tool + ':' + sid] = name
        atomic_json(ROOT / 'owners.json', o)


CHAT_NAME = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._-]{0,59}$')


def chat_names():
    """{'claude:<session id>': 'excel-calcs'}"""
    return read_json(ROOT / 'names.json', {})


def set_chat_name(tool, sid, name, force=False):
    if name and not CHAT_NAME.match(name):
        raise Error('chat names: letters, digits, . - _ (no spaces), e.g. excel-calcs')
    with lock('names'):
        names = chat_names()
        key = tool + ':' + sid
        if name:
            taken = [k for k, v in names.items() if v.lower() == name.lower() and k != key]
            if taken and not force:
                raise Error(f"'{name}' is already used by another chat (rose name ... --force to take it)")
            for k in taken:
                del names[k]
            names[key] = name
        else:
            names.pop(key, None)
        atomic_json(ROOT / 'names.json', names)


def ref(row):
    """How to refer to a chat on the command line."""
    return row.get('name') or row['id'][:8]


# ---- live Claude usage (recorded from the status line input, a documented Claude Code hook)

WINDOWS = (('five_hour', '5h'), ('seven_day', 'week'))


def usage_path(name):
    return ROOT / 'usage' / f'claude-{name}.json'


def claude_usage(name):
    """Last recorded plan usage: {'seen': ts, 'five_hour': {'used': 42, 'resets_at': ts}, ...} or {}."""
    return read_json(usage_path(name), {})


def window_used(info, now=None):
    """Percent used, or None if unknown / the window has reset since it was seen."""
    if not info or info.get('used') is None:
        return None
    if info.get('resets_at') and (now or time.time()) >= float(info['resets_at']):
        return None
    return float(info['used'])


CODEX_WINDOWS = {300: '5h', 10080: 'week'}


def codex_usage(name):
    """Latest rate-limit snapshot Codex itself wrote into this account's session files (no network)."""
    files = sorted(session_files('codex', name), key=lambda p: p.stat().st_mtime, reverse=True)[:20]
    for path in files:
        for item in reversed(jsonl_tail(path, 524288)):
            pl = item.get('payload') or {}
            if item.get('type') != 'event_msg' or pl.get('type') != 'token_count' or not pl.get('rate_limits'):
                continue
            seen = iso_ts(item.get('timestamp')) or path.stat().st_mtime
            rec = {'seen': seen}
            for key in ('primary', 'secondary'):
                w = pl['rate_limits'].get(key) or {}
                if w.get('used_percent') is None:
                    continue
                mins = w.get('window_minutes')
                label = CODEX_WINDOWS.get(mins) or (f'{mins // 60}h' if mins and mins % 60 == 0 else f'{mins}m' if mins else key)
                reset = w.get('resets_at')
                if reset is None and w.get('resets_in_seconds') is not None:
                    reset = seen + float(w['resets_in_seconds'])
                rec[label] = {'used': float(w['used_percent']), 'resets_at': reset}
            if len(rec) > 1:
                return rec
    return {}


def account_usage(tool, name):
    """(seen timestamp or None, [(label, {'used': %, 'resets_at': ts}), ...])"""
    if tool == 'claude':
        u = claude_usage(name)
        return u.get('seen'), [(label, u[key]) for key, label in WINDOWS if u.get(key)]
    u = codex_usage(name)
    return u.get('seen'), [(k, v) for k, v in u.items() if k != 'seen']


def no_usage_reason(tool, name):
    if tool == 'claude' and not claude_usage(name):
        return 'no usage seen yet: it appears after a chat runs on this account'
    if tool == 'codex':
        return 'no usage seen yet: Codex records it during chats'
    return 'usage not reported (API-key login?)'


def usage_text(tool, name):
    seen, wins = account_usage(tool, name)
    if not wins:
        return 'usage: ' + no_usage_reason(tool, name)
    parts = []
    for label, w in wins:
        used = window_used(w)
        reset = clock(float(w['resets_at'])) if w.get('resets_at') else '?'
        parts.append(f'{label} reset (was {w["used"]:.0f}%)' if used is None else f'{label} {used:.0f}% (resets {reset})')
    return ' · '.join(parts + [f'seen {ago(seen or 0)}'])


def exhausted(name, tool='claude'):
    return any((window_used(w) or 0) >= 100 for _, w in account_usage(tool, name)[1])


def bar(pct, width=24):
    filled = round(min(100.0, max(0.0, pct)) / 100 * width)
    return '█' * filled + '░' * (width - filled)


def paint(text, pct, limit=None):
    if not sys.stdout.isatty():
        return text
    hot = limit if limit else 90
    color = '31' if pct >= hot else '33' if pct >= min(70, hot - 10) else '32'
    return f'\x1b[{color}m{text}\x1b[0m'


def show_usage():
    """All accounts, your order first, one bar per usage window."""
    order = chain()
    everyone = order + [a for a in accounts() if a not in order]
    cool = cooldowns()
    limit = threshold('claude')
    print('Usage' + (f'   (Claude threshold {limit}%)' if limit else '') + '\n')
    for acct in everyone:
        tool, name = acct
        pos = f'#{order.index(acct) + 1} in order' if acct in order else ''
        flags = []
        if f'{tool}:{name}' in cool:
            flags.append(f"limit until {clock(cool[tool + ':' + name]['until'])}")
        if over_threshold(tool, name):
            flags.append(f'over {limit}%: skipped')
        if not has_login(tool, name):
            flags.append('not signed in')
        print(f'{spec(acct):<22} {pos}' + (f"   ⚠ {' · '.join(flags)}" if flags else ''))
        seen, wins = account_usage(tool, name)
        if not wins:
            print(f'  {no_usage_reason(tool, name)}\n')
            continue
        for label, w in wins:
            used = window_used(w)
            reset = clock(float(w['resets_at'])) if w.get('resets_at') else '?'
            if used is None:
                print(f'  {label:<5} {bar(0)}    0%  reset at {reset} (was {w["used"]:.0f}%)')
            else:
                lim = limit if tool == 'claude' else None
                print(f'  {label:<5} {paint(bar(used), used, lim)} {used:>4.0f}%  resets {reset}')
        print(f'  {"":<5} seen {ago(seen or 0)}\n')


def statusline_account():
    """Which rose Claude account the calling Claude process runs as."""
    named = os.environ.get('ROSE_CLAUDE')
    if named and ('claude', named) in accounts('claude'):
        return named
    home = Path(os.environ.get('CLAUDE_CONFIG_DIR') or native_home('claude')).resolve()
    for t, n in accounts('claude'):
        if account_home(t, n) == home:
            return n
    return None


def cmd_statusline(_argv):
    """Called by Claude Code as its status line: record usage, then run the original status line."""
    raw = sys.stdin.read()
    with contextlib.suppress(Exception):  # never break the status line
        data = json.loads(raw or '{}')
        limits = data.get('rate_limits') or {}
        name = statusline_account()
        if name and limits:
            rec = {'seen': time.time(), 'session': data.get('session_id')}
            for key, _ in WINDOWS:
                w = limits.get(key) or {}
                if w.get('used_percentage') is not None:
                    rec[key] = {'used': float(w['used_percentage']), 'resets_at': w.get('resets_at')}
            old = claude_usage(name)
            changed = any(old.get(k) != rec.get(k) for k, _ in WINDOWS)
            if changed or time.time() - old.get('seen', 0) > 60:
                atomic_json(usage_path(name), rec)
    original = (settings().get('statusline_original') or {}).get('command')
    out = ''
    if original:
        out = subprocess.run(original, shell=True, input=raw, capture_output=True, text=True).stdout.rstrip('\n')
    with contextlib.suppress(Exception):
        if os.environ.get('ROSE_SESSION'):                     # launched by rose: say so
            label = '🌹 rose · ' + os.environ['ROSE_SESSION'].split(':', 1)[1]
            if os.environ.get('ROSE_CHAT'):
                label += ' · ' + os.environ['ROSE_CHAT']
            out = label + ('  │ ' + out if out else '')
        name = statusline_account()
        if name and over_threshold('claude', name):
            live = os.environ.get('ROSE_SESSION') and live_switch_target('claude', name)
            nxt = next_targets('claude', name)
            out += f"  ⚠ {name} {max_used(name):.0f}%" + (
                f" → moving to {live[1]} after this reply" if live else
                f" → type 'move' ({nxt[0][1]})" if nxt else '')
    sys.stdout.write(out)
    return 0


def statusline_command():
    return shlex.quote(str(SELF)) + ' statusline'


def hook_command():
    return shlex.quote(str(SELF)) + ' hook prompt'


def is_rose_cmd(cmd, suffix):
    cmd = str(cmd or '')
    return cmd.endswith(suffix) and ('rose' in cmd)


def claude_settings_file():
    f = SHARED_SRC['claude'] / 'settings.json'
    return f.resolve() if f.is_symlink() else f


def write_claude_settings(f, data):
    shutil.copy2(f, f.with_name(f.name + '.bak-rose'))
    fd, tmp = tempfile.mkstemp(dir=f.parent, prefix='.rose-')
    with os.fdopen(fd, 'w') as out:
        out.write(json.dumps(data, indent=2, ensure_ascii=False) + '\n')
    os.chmod(tmp, 0o644)
    os.replace(tmp, f)


def integrate(install=True, quiet=False):
    """Status line (usage + rose marker) and the 'move' prompt hook, in the shared Claude settings."""
    s = settings()
    f = claude_settings_file()
    data = read_json(f, {}) if f.exists() else {}
    before = json.dumps(data, sort_keys=True)
    current = data.get('statusLine') or {}
    mine = is_rose_cmd(current.get('command'), ' statusline')
    groups = (data.get('hooks') or {}).get('UserPromptSubmit') or []
    kept = [g for g in groups if not any(is_rose_cmd(h.get('command'), ' hook prompt') for h in g.get('hooks', []))]
    if install:
        if not mine:
            s['statusline_original'] = current
            save_settings(s)
        data['statusLine'] = dict(current, type='command', command=statusline_command())
        data.setdefault('hooks', {})['UserPromptSubmit'] = kept + [
            {'hooks': [{'type': 'command', 'command': hook_command()}]}]
    else:
        orig = s.pop('statusline_original', None)
        save_settings(s)
        if mine:
            if orig and orig.get('command'):
                data['statusLine'] = orig
            else:
                data.pop('statusLine', None)
        if kept:
            data.setdefault('hooks', {})['UserPromptSubmit'] = kept
        elif 'hooks' in data:
            data['hooks'].pop('UserPromptSubmit', None)
            if not data['hooks']:
                del data['hooks']
    if json.dumps(data, sort_keys=True) != before:
        write_claude_settings(f, data)
    if not quiet:
        print('rose is ' + ('connected to' if install else 'disconnected from') + f' Claude Code ({f}).')
        if install:
            print('  status line: 🌹 marker in rose chats, usage recording, threshold warning')
            print("  hook:        type 'move' (or 'move to work') in a rose chat to move it")
    return 0


def cmd_setup(a):
    return integrate(not a.remove)


def cmd_usage(a):
    if a.action in ('install', 'uninstall'):
        return integrate(a.action == 'install')
    show_usage()
    if not is_rose_cmd((read_json(claude_settings_file(), {}).get('statusLine') or {}).get('command'), ' statusline'):
        print('Claude recording is off: rose setup')
    return 0


# ---------------------------------------------------------------- "move" inside a chat

MOVE_RE = re.compile(r'^\s*/?(?:rose\s+)?move(?:\s+(?:to\s+)?(?P<target>[A-Za-z0-9:_/.-]+))?\s*[.!]?\s*$', re.I)


def resolve_move_target(tool, name, word=None):
    here = (tool, name)
    if not word:
        options = next_targets(tool, name)
        if not options:
            raise Error('no other account is available (rose status)')
        return options[0]
    if word.lower() in TOOLS:
        t = word.lower()
        options = [a for a in chain() + accounts(t) if a[0] == t and a != here and has_login(*a)]
        if not options:
            raise Error(f'no other signed-in {LABEL[t]} account')
        return options[0]
    target = parse_spec(word)
    if target == here:
        raise Error(f'this chat is already on {spec(here)}')
    if not has_login(*target):
        raise Error(f'{spec(target)} is not signed in (rose login {target[0]} {target[1]})')
    return target


def cmd_hook(argv):
    """Claude Code UserPromptSubmit hook: 'move [to X]' is a rose command, not a message for the model."""
    with contextlib.suppress(Exception):
        data = json.loads(sys.stdin.read() or '{}')
        m = MOVE_RE.match(str(data.get('prompt', '')))
        if not m:
            return 0
        launcher, session = os.environ.get('ROSE_LAUNCHER'), os.environ.get('ROSE_SESSION', '')
        alive = False
        if launcher:
            with contextlib.suppress(OSError, ValueError):
                os.kill(int(launcher), 0)
                alive = True
        if not alive or ':' not in session:
            sid = str(data.get('session_id') or '')[:8] or '<chat>'
            reason = (f"rose: this chat was not started with rose, so it can't move itself. Exit, then run "
                      f"`rose move {sid}" + (f" --to {m.group('target')}" if m.group('target') else '') +
                      f"` and `rose resume {sid}`.")
        else:
            tool, name = session.split(':', 1)
            try:
                target = resolve_move_target(tool, name, m.group('target'))
                atomic_json(ROOT / 'requests' / f'{launcher}.json',
                            {'target': list(target), 'session': data.get('session_id'), 'time': time.time()})
                how = 'resuming there' if target[0] == tool else 'new chat there with this conversation'
                reason = f'rose: moving this chat to {spec(target)} ({how})…'
            except Error as e:
                reason = f'rose: cannot move: {e}'
        print(json.dumps({'decision': 'block', 'reason': reason}, ensure_ascii=False))
    return 0


def take_request(pid):
    f = ROOT / 'requests' / f'{pid}.json'
    req = read_json(f, None)
    if req:
        with contextlib.suppress(OSError):
            f.unlink()
        return tuple(req['target'])
    return None


def codex_message(item):
    """(role, text) for a user or assistant message in a Codex rollout. Older Codex writes
    event_msg user_message/agent_message; newer Codex writes event_msg item_completed with a
    UserMessage/AgentMessage item."""
    if item.get('type') != 'event_msg':
        return None
    p = item.get('payload') or {}
    kind = p.get('type')
    if kind in ('user_message', 'agent_message'):
        return ('user' if kind == 'user_message' else 'assistant'), str(p.get('message') or '')
    if kind == 'item_completed':
        it = p.get('item') or {}
        role = {'UserMessage': 'user', 'AgentMessage': 'assistant'}.get(it.get('type'))
        if role:
            parts = it.get('content') or []
            text = ''.join(str(c.get('text') or '') for c in parts
                           if isinstance(c, dict) and str(c.get('type', '')).lower() == 'text') \
                if isinstance(parts, list) else str(parts)
            return role, text
    return None


def codex_move_request(path, since, tool, name):
    """Codex has no prompt hook here: a last user message that is just 'move …' is the request."""
    for item in reversed(jsonl_tail(path, 65536)):
        msg = codex_message(item)
        if msg and msg[0] == 'user':
            m = MOVE_RE.match(msg[1])
            if m and iso_ts(item.get('timestamp')) >= since:
                with contextlib.suppress(Error):
                    return resolve_move_target(tool, name, m.group('target'))
            return None
    return None


def cooldowns():
    data = read_json(ROOT / 'cooldowns.json', {})
    now = time.time()
    return {k: v for k, v in data.items() if v.get('until', 0) > now}


def set_cooldown(tool, name, until, reason):
    with lock('cooldowns'):
        c = cooldowns()
        c[tool + ':' + name] = {'until': until, 'reason': reason}
        atomic_json(ROOT / 'cooldowns.json', c)


def clock(ts):
    t = dt.datetime.fromtimestamp(ts)
    fmt = '%H:%M' if t.date() == dt.date.today() else '%a %d %b %H:%M'
    return t.strftime(fmt)


def ago(ts):
    s = max(0, time.time() - ts)
    for unit, n in (('d', 86400), ('h', 3600), ('m', 60)):
        if s >= n:
            return '%d%s ago' % (s // n, unit)
    return 'now'


# ---------------------------------------------------------------- accounts

def account_dir(tool, name):
    return ROOT / 'accounts' / tool / name


def native_home(tool):
    return (Path.home() / ('.claude' if tool == 'claude' else '.codex')).resolve()


def home_value(tool, name):
    """Value for CLAUDE_CONFIG_DIR / CODEX_HOME, or None to leave it unset.

    An account adopting the native home must not set the variable: Claude Code
    keeps its state in ~/.claude.json only when CLAUDE_CONFIG_DIR is unset."""
    home = account_home(tool, name)
    return None if home == native_home(tool) else str(home)


def account_home(tool, name):
    """The directory the tool uses. Adopted accounts are symlinks to an existing home."""
    return account_dir(tool, name).resolve()


def accounts(tool=None):
    out = []
    for t in ([tool] if tool else TOOLS):
        base = ROOT / 'accounts' / t
        if base.is_dir():
            out += [(t, p.name) for p in sorted(base.iterdir()) if p.is_dir() and NAME.match(p.name)]
    return out


def parse_spec(spec, tool=None):
    """'work', 'claude:work' or 'claude/work' -> (tool, name)."""
    m = re.match(r'^(claude|codex)[:/](.+)$', spec)
    if m:
        tool, spec = m.group(1), m.group(2)
    matches = [a for a in accounts(tool) if a[1] == spec]
    if not matches:
        where = LABEL[tool] + ' ' if tool else ''
        raise Error(f"no {where}account '{spec}'. Accounts: " +
                    (', '.join(f'{t}:{n}' for t, n in accounts(tool)) or 'none (rose add claude work)'))
    if len(matches) > 1:
        raise Error(f"'{spec}' exists for both tools; say claude:{spec} or codex:{spec}")
    return matches[0]


def env_file(tool, name):
    return ROOT / 'env' / f'{tool}-{name}.env'


def load_env_file(path):
    out = {}
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return out
    for line in lines:
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        line = re.sub(r'^export\s+', '', line)
        if '=' in line:
            k, v = line.split('=', 1)
            v = v.strip()
            if len(v) >= 2 and v[0] == v[-1] and v[0] in '"\'':
                v = v[1:-1]
            out[k.strip()] = v
    return out


def environment(tool, name, base=None):
    env = dict(os.environ if base is None else base)
    for var in AUTH_ENV[tool]:
        env.pop(var, None)
    value = home_value(tool, name)
    if value:
        env[HOME_VAR[tool]] = value
    else:
        env.pop(HOME_VAR[tool], None)
    env['ROSE_' + tool.upper()] = name
    env.update(load_env_file(env_file(tool, name)))
    return env


def claude_state_file(home):
    """Claude keeps .claude.json inside CLAUDE_CONFIG_DIR, except for the default home (~/.claude.json)."""
    return Path.home() / '.claude.json' if home == native_home('claude') else home / '.claude.json'


def has_login(tool, name):
    """Cheap, offline check used for routing."""
    home = account_home(tool, name)
    if tool == 'codex':
        return (home / 'auth.json').is_file()
    if (home / '.credentials.json').is_file():
        return True
    data = read_json(claude_state_file(home), {})
    return bool(data.get('oauthAccount')) or bool(load_env_file(env_file(tool, name)))


def identity(tool, name):
    """(auth description, email) from the tool itself."""
    env = environment(tool, name)
    home = account_home(tool, name)
    try:
        if tool == 'claude':
            r = subprocess.run([BINARY['claude'], 'auth', 'status', '--json'], env=env,
                               capture_output=True, text=True, timeout=20)
            info = json.loads(r.stdout or '{}')
            auth = info.get('authMethod') if info.get('loggedIn') else 'not logged in'
            if info.get('apiKeySource'):
                auth += ' (' + info['apiKeySource'] + ')'
            acct = read_json(claude_state_file(home), {}).get('oauthAccount') or {}
            return auth, acct.get('emailAddress', '')
        r = subprocess.run([BINARY['codex'], 'login', 'status'], env=env, capture_output=True,
                           text=True, timeout=20)
        lines = [ln for ln in (r.stdout + r.stderr).splitlines() if ln.strip() and 'WARNING' not in ln]
        return (lines[-1].strip() if lines else ('logged in' if r.returncode == 0 else 'not logged in')), ''
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        return 'unknown (%s)' % e.__class__.__name__, ''


def link_shared(tool, name, quiet=False):
    src, home = SHARED_SRC[tool], account_home(tool, name)
    if src.resolve() == home:
        return  # adopted default home: it is the shared source
    for item in SHARED_ITEMS[tool]:
        s, t = src / item, home / item
        if not s.exists() or t.is_symlink():
            continue
        if t.exists():
            if not quiet:
                print(f'  keep  {t} (account-specific copy; delete it to share)')
            continue
        t.symlink_to(s)
        if not quiet:
            print(f'  link  {t} -> {s}')


def shared_warnings():
    out = []
    f = SHARED_SRC['claude'] / 'settings.json'
    data = read_json(f, {})
    for var in AUTH_ENV['claude']:
        if var in (data.get('env') or {}):
            out.append(f'{f} sets {var} in "env": it applies to EVERY Claude account and overrides '
                       f'their logins. Move it to the env file of the account that should use it '
                       f'(rose env claude <name>).')
    if data.get('apiKeyHelper'):
        out.append(f'{f} has apiKeyHelper; it applies to every Claude account.')
    return out


# ---------------------------------------------------------------- sessions

def jsonl_head(path, limit=262144):
    with open(path, errors='replace') as f:
        for line in f.read(limit).splitlines():
            with contextlib.suppress(ValueError):
                yield json.loads(line)


def jsonl_tail(path, limit=262144):
    with open(path, 'rb') as f:
        f.seek(0, 2)
        size = f.tell()
        f.seek(max(0, size - limit))
        data = f.read().decode('utf-8', 'replace').splitlines()
    if size > limit:
        data = data[1:]
    out = []
    for line in data:
        with contextlib.suppress(ValueError):
            out.append(json.loads(line))
    return out


def clean(text, n=70):
    text = ' '.join(str(text).split())
    return text if len(text) <= n else text[:n - 1] + '…'


def user_text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return ' '.join(c.get('text', '') for c in content if isinstance(c, dict) and c.get('type') == 'text')
    return ''


def claude_session(path, name):
    cwd, first = '', ''
    for item in jsonl_head(path):
        cwd = cwd or item.get('cwd', '')
        if not first and item.get('type') == 'user' and not item.get('isMeta'):
            t = user_text((item.get('message') or {}).get('content'))
            if t.strip() and not t.lstrip().startswith('<'):
                first = t
        if cwd and first:
            break
    title = ''
    for item in reversed(jsonl_tail(path, 131072)):
        title = item.get('customTitle') or item.get('aiTitle') or ''
        if title:
            break
    return dict(tool='claude', account=name, id=path.stem, cwd=cwd, title=clean(title or first or '(untitled)'),
                modified=path.stat().st_mtime, path=str(path))


def codex_session(path, name):
    head = list(jsonl_head(path))
    if not head or head[0].get('type') != 'session_meta':
        return None
    meta = head[0].get('payload') or {}
    title = ''
    for item in head:
        msg = codex_message(item)
        if msg and msg[0] == 'user':
            t = msg[1]
            if t.strip() and not t.lstrip().startswith('<') and not t.startswith('[rose') and not MOVE_RE.match(t):
                title = t
                break
    return dict(tool='codex', account=name, id=str(meta.get('id', '')), cwd=meta.get('cwd', ''),
                title=clean(title or '(untitled)'), modified=path.stat().st_mtime, path=str(path),
                history_mode=meta.get('history_mode', 'legacy'))


def session_files(tool, name):
    home = account_home(tool, name)
    if tool == 'claude':
        return sorted((home / 'projects').glob('*/*.jsonl')) if (home / 'projects').is_dir() else []
    return sorted((home / 'sessions').rglob('rollout-*.jsonl')) if (home / 'sessions').is_dir() else []


def sessions(tool=None, account=None):
    own = owners()
    rows = {}
    for t, n in accounts(tool):
        if account and n != account:
            continue
        for p in session_files(t, n):
            try:
                row = claude_session(p, n) if t == 'claude' else codex_session(p, n)
            except OSError:
                continue
            if not row or not row['id']:
                continue
            key = t + ':' + row['id']
            owner = own.get(key)
            if owner and owner != n:
                continue  # stale copy left behind by a move
            if key not in rows or rows[key]['modified'] < row['modified']:
                rows[key] = row
    running = {(r['tool'], r.get('sid')) for r in running_records()}
    names = chat_names()
    for key, r in rows.items():
        r['open'] = (r['tool'], r['id']) in running
        r['name'] = names.get(key)
    return sorted(rows.values(), key=lambda r: r['modified'], reverse=True)


def find_session(prefix, tool=None):
    """A chat by rose name, then by the tool's own title (/rename), then by id prefix."""
    everything = sessions(tool)
    low = prefix.lower()
    for match in ([r for r in everything if (r.get('name') or '').lower() == low],
                  [r for r in everything if r['title'].lower() == low]):
        if len(match) == 1:
            return match[0]
    rows = [r for r in everything if r['id'].startswith(prefix)]
    if not rows:
        raise Error(f"no chat named or with id '{prefix}' (rose sessions)")
    if len({(r['tool'], r['id']) for r in rows}) > 1:
        raise Error(f"'{prefix}' matches several chats; use more characters")
    return rows[0]


# ---------------------------------------------------------------- running registry

def running_records():
    d = ROOT / 'running'
    out = []
    if not d.is_dir():
        return out
    for f in d.glob('*.json'):
        r = read_json(f, None)
        try:
            os.kill(int(r['pid']), 0)
            out.append(r)
        except (TypeError, KeyError, ValueError, ProcessLookupError, PermissionError):
            with contextlib.suppress(OSError):
                f.unlink()
    return out


def register(pid, **fields):
    fields['pid'] = pid
    atomic_json(ROOT / 'running' / f'{pid}.json', fields)


def unregister(pid):
    with contextlib.suppress(OSError):
        (ROOT / 'running' / f'{pid}.json').unlink()


# ---------------------------------------------------------------- moving chats

def backup(path):
    dest = private_dir(ROOT / 'backups' / time.strftime('%Y%m%d-%H%M%S')) / (uuid.uuid4().hex[:8] + '-' + path.name)
    (shutil.copytree if path.is_dir() else shutil.copy2)(path, dest)
    return dest


def stable_copy(src, dst):
    private_dir(dst.parent)
    fd, tmp = tempfile.mkstemp(dir=dst.parent, prefix='.rose-')
    os.close(fd)
    try:
        before = src.stat()
        shutil.copyfile(src, tmp)
        after = src.stat()
        if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
            raise Error('the chat changed while copying; close it and retry')
        os.replace(tmp, dst)
    finally:
        with contextlib.suppress(OSError):
            os.unlink(tmp)


@contextlib.contextmanager
def codex_writer_lock(home, sid):
    d = private_dir(home / 'thread-writer-locks')
    with open(d / (sid + '.lock'), 'a') as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Error('Codex is using this conversation; close it first')
        yield


def codex_reset_projection(home, sid):
    """Paginated history: derived per-thread tables are rebuilt by Codex on resume (as in codexx)."""
    dbs = list(home.glob('thread_history_*.sqlite'))
    if not dbs:
        return
    if len(dbs) != 1 or dbs[0].name != 'thread_history_1.sqlite':
        raise Error('unsupported Codex history database version; nothing was moved')
    db = sqlite3.connect(dbs[0], timeout=5)
    try:
        tables = {r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        for t in sorted(tables & {'thread_turns', 'thread_items', 'thread_history_projection_state',
                                  'thread_realtime_items'}):
            if 'thread_id' in {r[1] for r in db.execute(f'PRAGMA table_info("{t}")')}:
                db.execute(f'DELETE FROM "{t}" WHERE thread_id = ?', (sid,))
        db.commit()
    finally:
        db.close()


def codex_ancestors(path, home, seen=None):
    """Rollouts this paginated history depends on (history_base chain)."""
    seen = seen or set()
    meta = (next(jsonl_head(path, 1048576), {}) or {}).get('payload') or {}
    base = (meta.get('history_base') or {}).get('thread_id')
    if not base or base in seen:
        return []
    seen.add(base)
    found = list((home / 'sessions').rglob(f'*{base}.jsonl'))
    if len(found) != 1:
        raise Error(f'missing or ambiguous parent history {base}; nothing was moved')
    return [found[0]] + codex_ancestors(found[0], home, seen)


def move(row, target, quiet=False, event='moved'):
    tool, source = row['tool'], row['account']
    if target == source:
        raise Error('the chat already belongs to that account')
    if (tool, target) not in accounts(tool):
        raise Error(f"no {LABEL[tool]} account '{target}'")
    if any(r['tool'] == tool and r.get('sid') == row['id'] for r in running_records()):
        raise Error('this chat is open in a rose session; exit it first')
    src_home, dst_home = account_home(tool, source), account_home(tool, target)
    src = Path(row['path'])
    with lock(f'move-{tool}-{row["id"]}'):
        if tool == 'claude':
            rel = src.relative_to(src_home / 'projects')
            dst = dst_home / 'projects' / rel
            if dst.exists():
                backup(dst)
            stable_copy(src, dst)
            extras = [(src.with_suffix(''), dst.with_suffix('')),                     # subagents, tool results
                      (src_home / 'file-history' / row['id'], dst_home / 'file-history' / row['id'])]
            for a, b in extras:
                if a.is_dir():
                    shutil.copytree(a, b, dirs_exist_ok=True)
        else:
            with codex_writer_lock(src_home, row['id']), codex_writer_lock(dst_home, row['id']):
                for anc in codex_ancestors(src, src_home):
                    dest = dst_home / anc.relative_to(src_home)
                    if not dest.exists():
                        stable_copy(anc, dest)
                existing = list((dst_home / 'sessions').rglob(f'*{row["id"]}.jsonl'))
                dst = existing[0] if existing else dst_home / src.relative_to(src_home)
                if dst.exists():
                    backup(dst)
                stable_copy(src, dst)
                codex_reset_projection(dst_home, row['id'])
        set_owner(tool, row['id'], target)
        record(event, tool=tool, session=row['id'], account=target, previous=source,
               cwd=row.get('cwd'), title=row.get('title'))
    if not quiet:
        print(f"Moved {LABEL[tool]} chat {row['id'][:8]} from {source} to {target} (original kept).")


# ---------------------------------------------------------------- usage-limit detection

ISO = re.compile(r'^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d+))?(Z|[+-]\d\d:?\d\d)?$')


def iso_ts(value):
    """ISO-8601 timestamp -> epoch seconds; 0 if unreadable. Works on Python 3.9, whose fromisoformat
    rejects 'Z' and fractions other than 3 or 6 digits (Claude and Codex write both)."""
    m = ISO.match(str(value).strip())
    if not m:
        return 0
    frac = ((m.group(2) or '') + '000000')[:6]
    zone = m.group(3) or '+00:00'
    zone = '+00:00' if zone == 'Z' else (zone if ':' in zone else zone[:3] + ':' + zone[3:])
    try:
        return dt.datetime.fromisoformat(f'{m.group(1)}.{frac}{zone}').timestamp()
    except ValueError:
        return 0


def claude_limit(path, since):
    """Last conversational entry is a usage-limit error newer than `since` -> info dict."""
    for item in reversed(jsonl_tail(path)):
        if item.get('type') not in ('user', 'assistant') or item.get('isMeta') or item.get('isSidechain'):
            continue
        if item.get('type') == 'user':
            return None
        limited = item.get('apiError') == 'usage_limit_reached' or (
            item.get('error') == 'rate_limit' and (item.get('quotaLimits') or {}).get('status') == 'rejected')
        if not (item.get('isApiErrorMessage') and limited):
            return None
        if iso_ts(item.get('timestamp')) < since:
            return None
        info = ((item.get('apiErrorParams') or {}).get('rate_limit_info') or item.get('quotaLimits') or {})
        return dict(reset=info.get('resetsAt'), kind=info.get('rateLimitType', 'usage limit'),
                    text=user_text((item.get('message') or {}).get('content')))
    return None


def codex_limit(path, since):
    for item in reversed(jsonl_tail(path)):
        if item.get('type') != 'event_msg':
            continue
        p = item.get('payload') or {}
        kind = p.get('type')
        if codex_message(item):
            return None
        if kind not in ('error', 'stream_error'):
            continue
        info = json.dumps(p.get('codex_error_info', ''))
        msg = str(p.get('message', ''))
        if not (re.search(r'usage_?limit', info, re.I) or re.search(r'usage limit|hit your .*limit', msg, re.I)):
            return None
        if iso_ts(item.get('timestamp')) < since:
            return None
        return dict(reset=None, kind='usage limit', text=msg)
    return None


def current_transcript(tool, name, cwd, since, sid=None):
    """The chat a launched process is writing: the newest transcript touched since launch."""
    home = account_home(tool, name)
    files = session_files(tool, name)
    fresh = [p for p in files if p.stat().st_mtime >= since - 1]
    if tool == 'claude':
        enc = re.sub(r'[^A-Za-z0-9]', '-', str(cwd))
        local = [p for p in fresh if p.parent.name == enc]
        fresh = local or fresh
    elif fresh:
        fresh = [p for p in fresh if (codex_session(p, name) or {}).get('cwd') == str(cwd)] or fresh
    if fresh:
        return max(fresh, key=lambda p: p.stat().st_mtime)
    if sid:
        hits = list(home.glob(f'projects/*/{sid}.jsonl')) if tool == 'claude' else \
            list((home / 'sessions').rglob(f'*{sid}.jsonl'))
        return hits[0] if hits else None
    return None


# ---------------------------------------------------------------- launching

def defaults_args(tool, args):
    d = settings()['defaults'].get(tool, {})
    out = []
    if tool == 'claude':
        if d.get('model') and '--model' not in args:
            out += ['--model', d['model']]
        if d.get('effort') and '--effort' not in args:
            out += ['--effort', d['effort']]
        if d.get('yolo') and '--dangerously-skip-permissions' not in args:
            out += ['--dangerously-skip-permissions']
    else:
        if d.get('model') and not {'-m', '--model'} & set(args):
            out += ['-m', d['model']]
        if d.get('effort'):
            out += ['-c', f'model_reasoning_effort="{d["effort"]}"']
        if d.get('yolo') and '--dangerously-bypass-approvals-and-sandbox' not in args:
            out += ['--dangerously-bypass-approvals-and-sandbox']
    return out


def build_cmd(tool, args, resume=None, new_sid=None, prompt=None):
    b = BINARY[tool]
    extra = defaults_args(tool, args)
    tail = [prompt] if prompt else []
    if tool == 'claude':
        if resume:
            return [b, '--resume', resume] + extra + args + tail
        return [b] + (['--session-id', new_sid] if new_sid else []) + extra + args + tail
    extra = no_daemon(args) + keep_title(args) + extra
    if resume:
        return [b, 'resume'] + extra + args + [resume] + tail
    return [b] + extra + args + tail


def no_daemon(args):
    """Codex's TUI uses a shared background server by default. It fails on installs without the full
    package ("this CLI has no complete local package"), and a server shared by every account is not
    what rose wants anyway: each chat gets its own (as codexx does with --no-daemon)."""
    return [] if {'--no-daemon', '--remote'} & set(args) else ['--no-daemon']


def keep_title(args):
    """Codex draws full-screen and sets its own window title, so neither rose's banner nor its title
    would stay visible. Codex has no place for custom text in the chat itself; turning its title off
    leaves rose's 🌹 title on the window/tab (unless the user configured a title themselves)."""
    return [] if any('terminal_title' in a for a in args) else ['-c', 'tui.terminal_title=[]']


def set_title(text):
    if sys.stdout.isatty():
        sys.stdout.write(f'\x1b]0;{text}\x07')
        sys.stdout.flush()


def restore_terminal():
    if sys.stdout.isatty():
        sys.stdout.write('\x1b[?1049l\x1b[?25h\x1b[0m\x1b[<u\n')
        sys.stdout.flush()
        subprocess.run(['stty', 'sane'], stdin=sys.stdin, check=False)


def failover_mode(tool, override=None):
    mode = override or settings()['failover'].get(tool, 'ask')
    return mode if mode in MODES else 'ask'


def candidates(tool, exclude):
    cool = cooldowns()
    order = [n for t, n in chain() if t == tool] or settings().get('order', {}).get(tool, [])
    names = [n for t, n in accounts(tool) if n not in exclude and has_login(t, n) and f'{t}:{n}' not in cool
             and not exhausted(n, tool)]

    def rank(n):
        known = [x for x in (window_used(w) for _, w in account_usage(tool, n)[1]) if x is not None]
        return (order.index(n) if n in order else len(order), max(known) if known else 50)
    return sorted(names, key=rank)


def ask(question, default=False):
    if not sys.stdin.isatty():
        return default
    try:
        a = input(question + (' [Y/n] ' if default else ' [y/N] ')).strip().lower()
    except EOFError:
        return default
    return default if not a else a in ('y', 'yes')


def pick(title, options, allow_none=True, enter_first=False, cancel_word='cancel'):
    """Numbered picker. options: list of (value, label). Returns value or None.
    enter_first: Enter picks option 1 and 'n' cancels (used for switching, where yes is the default)."""
    if not options:
        return None
    if not sys.stdin.isatty():
        raise Error(title + ': not a terminal, pass it explicitly')
    print(title)
    for i, (_, label) in enumerate(options, 1):
        print(f'  {i:>2}) {label}')
    hint = f' (enter = 1, n = {cancel_word})' if enter_first else (' (enter = cancel)' if allow_none else '')
    while True:
        try:
            a = input('  choose' + hint + ': ').strip().lower()
        except EOFError:
            return None
        if enter_first and not a:
            return options[0][0]
        if enter_first and a in ('n', 'no', 'q'):
            return None
        if not a and allow_none and not enter_first:
            return None
        if a.isdigit() and 1 <= int(a) <= len(options):
            return options[int(a) - 1][0]


def pinned(tool, start=None):
    d = Path(start or os.getcwd()).resolve()
    for p in [d] + list(d.parents):
        f = p / '.rose'
        if f.is_file():
            for line in f.read_text().splitlines():
                m = re.match(r'^\s*(claude|codex)\s*[=:]\s*([A-Za-z0-9_-]+)\s*$', line)
                if m and m.group(1) == tool:
                    return m.group(2)
            return None
    return None


def active_in_shell(tool):
    v = os.environ.get(HOME_VAR[tool])
    if not v:
        return os.environ.get('ROSE_' + tool.upper()) if (tool, os.environ.get('ROSE_' + tool.upper())) in accounts(tool) else None
    for t, n in accounts(tool):
        if account_home(t, n) == Path(v).resolve():
            return n
    return None


# ---------------------------------------------------------------- order, threshold, handoff

def chain():
    """The global account order, e.g. [('claude','personal'), ('codex','main'), ('claude','work')]."""
    out = []
    for spec in settings().get('chain', []):
        t, _, n = spec.partition(':')
        if (t, n) in accounts(t):
            out.append((t, n))
    return out


def threshold(tool):
    return settings().get('threshold', {}).get(tool) if tool == 'claude' else None


def max_used(name):
    u = claude_usage(name)
    known = [x for x in (window_used(u.get(k)) for k, _ in WINDOWS) if x is not None]
    return max(known) if known else None


def over_threshold(tool, name):
    limit, used = threshold(tool), (max_used(name) if tool == 'claude' else None)
    return limit is not None and used is not None and used >= limit


def live_switch_on():
    return bool(settings().get('threshold_live'))


def live_switch_target(tool, name, tried=(), override=None):
    """Where a running chat goes once its account passes the threshold: the next switch, if it is
    automatic and that account is itself under the threshold. Otherwise None (the status line warns)."""
    if not live_switch_on() or not over_threshold(tool, name):
        return None
    plan = switch_targets(tool, name, tried, override)
    if plan and plan[0][1] == 'auto' and not over_threshold(*plan[0][0]):
        return plan[0][0]
    return None


def claude_turn_done(path):
    """True when the last conversation entry is a finished Claude reply (not mid-task)."""
    for item in reversed(jsonl_tail(path, 131072)):
        if item.get('isSidechain') or item.get('type') not in ('user', 'assistant'):
            continue
        if item.get('type') == 'user':
            return False
        return (item.get('message') or {}).get('stop_reason') == 'end_turn' and not item.get('isApiErrorMessage')
    return False


def usable(tool, name):
    return has_login(tool, name) and f'{tool}:{name}' not in cooldowns() and not exhausted(name, tool)


def next_targets(tool, name, tried=()):
    """Where to go from (tool, name): your order (any tool), else other accounts of the same tool.
    `rose order --from next` (default) continues after the current account and wraps around;
    `--from top` always starts again at #1. Accounts over the threshold are a last resort."""
    order = chain()
    if order:
        if settings().get('order_from', 'next') == 'top':
            pool = list(order)
        else:
            i = order.index((tool, name)) + 1 if (tool, name) in order else 0
            pool = order[i:] + order[:i]
    else:
        pool = [(tool, n) for n in candidates(tool, set())]
    pool = [a for a in pool if a != (tool, name) and a not in tried and usable(*a)]
    return [a for a in pool if not over_threshold(*a)] + [a for a in pool if over_threshold(*a)]


def rule_key(src, dst):
    return f'{src[0]}:{src[1]}>{dst[0]}:{dst[1]}'


def mode_for(src, dst, override=None):
    """ask / auto / off for switching a chat from account src to account dst."""
    if override in MODES:
        return override
    s = settings()
    if s.get('failover_advanced'):
        rule = s.get('failover_rules', {}).get(rule_key(src, dst))
        if rule in MODES:
            return rule
    mode = s['failover'].get(src[0], 'ask')
    return mode if mode in MODES else 'ask'


def switch_targets(tool, name, tried=(), override=None):
    """[(account, mode)] in the order rose would try them; switches set to 'off' are left out."""
    out = []
    for t in next_targets(tool, name, tried):
        m = mode_for((tool, name), t, override)
        if m != 'off':
            out.append((t, m))
    return out


def failover_label(tool, override=None):
    if override:
        return override
    return 'custom' if settings().get('failover_advanced') else failover_mode(tool)


def first_available(tried=()):
    """Start of the order: the first usable account under the threshold."""
    order = [a for a in chain() if a not in tried and usable(*a)]
    under = [a for a in order if not over_threshold(*a)]
    return (under or order or [None])[0]


def spec(acct):
    return f'{LABEL[acct[0]]} · {acct[1]}'


def claude_digest(path):
    items = []
    with open(path, errors='replace') as f:
        for line in f:
            with contextlib.suppress(ValueError):
                d = json.loads(line)
                if d.get('type') not in ('user', 'assistant') or d.get('isMeta') or d.get('isSidechain') \
                        or d.get('isApiErrorMessage'):
                    continue
                text = user_text((d.get('message') or {}).get('content'))
                if text.strip() and not text.lstrip().startswith('<'):
                    items.append(('User' if d['type'] == 'user' else 'Assistant', text.strip()))
    return items


def codex_digest(path):
    items = []
    with open(path, errors='replace') as f:
        for line in f:
            with contextlib.suppress(ValueError):
                d = json.loads(line)
                msg = codex_message(d)
                if msg:
                    text = msg[1].strip()
                    item = ('User' if msg[0] == 'user' else 'Assistant', text)
                    if text and not text.startswith('<') and not text.startswith('[rose') and \
                            not MOVE_RE.match(text) and (not items or items[-1] != item):
                        items.append(item)
    return items


def handoff_prompt(src, path, cwd, budget=40000, reason='limit'):
    """A new chat on another tool gets the conversation so far, newest kept when it is long."""
    items = (claude_digest if src[0] == 'claude' else codex_digest)(path)
    parts, used = [], 0
    for role, text in reversed(items):
        if len(text) > 4000:
            text = text[:4000] + ' …[shortened]'
        if used + len(text) > budget:
            parts.append('…[earlier messages omitted]')
            break
        parts.append(f'### {role}\n{text}')
        used += len(text)
    if reason == 'moved':
        head = (f'[rose handoff] The user moved this conversation here from {LABEL[src[0]]} (account {src[1]}). '
                f'Below is that conversation so far, oldest first. Do not start new work: briefly confirm you '
                f'have the context and wait for the next instruction. The working directory is {cwd}.')
    elif reason == 'threshold':
        head = (f'[rose handoff] This conversation was moved here from {LABEL[src[0]]} (account {src[1]}), '
                f'which reached its usage threshold. Below is that conversation so far, oldest first. The last '
                f'reply was finished. Do not start new work: briefly confirm you have the context and wait for '
                f'the next instruction. The working directory is {cwd}.')
    else:
        head = (f'[rose handoff] This task was started in {LABEL[src[0]]} (account {src[1]}), which hit its '
                f'usage limit. Below is that conversation so far, oldest first. Continue the task from where it '
                f'stopped. The working directory is {cwd}; inspect it to see what was already done, and do not '
                f'repeat anything that has side effects.')
    return head + '\n\n' + '\n\n'.join(reversed(parts))


def choose_account(tool, explicit=None):
    if explicit:
        return parse_spec(explicit, tool)[1]
    names = [n for _, n in accounts(tool)]
    if not names:
        raise Error(f'no {LABEL[tool]} accounts yet: rose add {tool} <name>')
    for how in (active_in_shell(tool), pinned(tool), settings().get('default', {}).get(tool)):
        if how in names:
            return how
    if len(names) == 1:
        return names[0]
    cool = cooldowns()
    opts = [(n, n + (f'  (limit until {clock(cool[tool + ":" + n]["until"])})' if f'{tool}:{n}' in cool else ''))
            for n in names]
    choice = pick(f'{LABEL[tool]} account:', opts)
    if not choice:
        raise Error('no account chosen')
    return choice


def launch(tool, name, args, cwd=None, resume=None, prompt=None, mode=None, chat_name=None, tried=None):
    """Run the native TUI under an account. Afterwards: a 'move' request or a usage limit continues the
    chat on another account (same tool: move + resume; other tool: new chat with the context handed over)."""
    if chat_name and not CHAT_NAME.match(chat_name):
        raise Error('chat names: letters, digits, . - _ (no spaces), e.g. excel-calcs')
    if chat_name and any(v.lower() == chat_name.lower() for v in chat_names().values()):
        raise Error(f"'{chat_name}' is already used by another chat")
    cwd = str(Path(cwd or os.getcwd()).resolve())
    override = mode
    tried = {tuple(x) for x in (tried or [])} | {(tool, name)}
    first = True
    while True:
        if not first and code_changed():   # rose was updated while this chat ran: continue on the new code
            adopt_new_code(dict(tool=tool, name=name, args=args, cwd=cwd, resume=resume, prompt=prompt,
                                mode=override, chat_name=chat_name, tried=sorted(tried)))
        first = False
        mode = failover_label(tool, override)
        if not has_login(tool, name):
            print(f'rose: {LABEL[tool]} account {name} has no login yet (rose login {tool} {name})', file=sys.stderr)
        new_sid = str(uuid.uuid4()) if tool == 'claude' and not resume and not \
            {'-r', '--resume', '-c', '--continue', '--session-id'} & set(args) else None
        if chat_name and new_sid:
            set_chat_name(tool, new_sid, chat_name)
        cmd = build_cmd(tool, args, resume, new_sid, prompt)
        shown = chat_name or (chat_names().get(f'{tool}:{resume}') if resume else None)
        print(f'🌹 rose · {LABEL[tool]} · {name}' + (f' · {shown}' if shown else '') +
              (f' · resuming {resume[:8]}' if resume else '') +
              f" · failover {mode} · type 'move' to switch account", file=sys.stderr)
        set_title(f'🌹 rose · {LABEL[tool]} · {name}' + (f' · {shown}' if shown else ''))
        start = time.time()
        killed = threading.Event()
        done = threading.Event()
        request = {}
        env = environment(tool, name)
        env.update(ROSE_LAUNCHER=str(os.getpid()), ROSE_SESSION=f'{tool}:{name}', ROSE_VERSION=VERSION)
        if shown:
            env['ROSE_CHAT'] = shown
        take_request(os.getpid())  # drop a stale request
        try:
            proc = subprocess.Popen(cmd, env=env, cwd=cwd)
        except FileNotFoundError:
            raise Error(f'{BINARY[tool]} not found on PATH')
        register(proc.pid, tool=tool, account=name, sid=resume or new_sid, cwd=cwd, started=start)
        record('opened', tool=tool, account=name, session=resume or new_sid, cwd=cwd)

        def stop(proc=proc):
            time.sleep(0.5)
            killed.set()
            with contextlib.suppress(OSError):
                proc.terminate()

        live_ok = tool == 'claude' and not over_threshold(tool, name)  # crossed during this chat only

        def watch(tool=tool, name=name, start=start, sid=resume or new_sid, tried=frozenset(tried),
                  live_ok=live_ok):
            ticks = 0
            while not done.wait(0.5):
                ticks += 1
                target = take_request(os.getpid())
                path = None
                if not target and tool == 'codex' and ticks % 2 == 0:
                    path = current_transcript(tool, name, cwd, start, sid)
                    target = path and codex_move_request(path, start, tool, name)
                if target:
                    request['target'] = target
                    return stop()
                if ticks % 4 == 0:
                    path = path or current_transcript(tool, name, cwd, start, sid)
                    if live_ok and path and time.time() - path.stat().st_mtime >= 2 and claude_turn_done(path):
                        target = live_switch_target(tool, name, tried | {(tool, name)}, override)
                        if target:                     # past the threshold, reply finished: move now
                            request.update(target=target, why='threshold')
                            return stop()
                    if path and (claude_limit if tool == 'claude' else codex_limit)(path, start):
                        plan = switch_targets(tool, name, tried | {(tool, name)}, override)
                        if plan and plan[0][1] == 'auto':      # the next switch is automatic: do it now
                            time.sleep(1)  # let the tool finish writing the error
                            return stop()
                        return                                  # ask: wait for the user to leave the chat
        threading.Thread(target=watch, daemon=True).start()
        old = signal.signal(signal.SIGINT, signal.SIG_IGN)  # Ctrl-C belongs to the TUI
        try:
            rc = proc.wait()
        finally:
            done.set()
            signal.signal(signal.SIGINT, old)
            unregister(proc.pid)
        request.setdefault('target', take_request(os.getpid()))
        if killed.is_set():
            restore_terminal()
            rc = 0  # we closed it on purpose
        elif rc < 0:
            rc = 128 - rc

        path = current_transcript(tool, name, cwd, start, resume or new_sid)
        sid = None
        if path:
            sid = path.stem if tool == 'claude' else (codex_session(path, name) or {}).get('id')
            if sid:
                set_owner(tool, sid, name)
                if chat_name and not chat_names().get(tool + ':' + sid):
                    with contextlib.suppress(Error):
                        set_chat_name(tool, sid, chat_name)
        label = chat_names().get(f'{tool}:{sid}') or (sid or '')[:8]

        target = request.get('target')
        if target:                                      # the user typed 'move' in the chat
            if not sid:
                print('rose: could not find this chat to move it', file=sys.stderr)
                return rc
            if request.get('why') == 'threshold':
                event, reason = 'threshold_switched', 'threshold'
                print(f'rose: {name} reached {max_used(name):.0f}% (threshold {threshold(tool)}%); '
                      f'moving this chat to {spec(target)}.', file=sys.stderr)
            else:
                event, reason = 'moved_in_chat', 'moved'
        else:
            info = path and (claude_limit if tool == 'claude' else codex_limit)(path, start)
            if not info:
                if sid:
                    print(f'rose: resume with: rose resume {label}' +
                          ('' if label != sid[:8] else f'   (name it: rose name {label} <name>)'), file=sys.stderr)
                if over_threshold(tool, name):
                    nxt = next_targets(tool, name)
                    print(f'rose: {name} is at {max_used(name):.0f}% (threshold {threshold(tool)}%)' +
                          (f'; new chats will start on {spec(nxt[0])}' if nxt else ''), file=sys.stderr)
                return rc
            until = float(info['reset']) if info.get('reset') else time.time() + DEFAULT_COOLDOWN
            set_cooldown(tool, name, until, info['kind'])
            record('limit', tool=tool, account=name, session=sid, until=until, kind=info['kind'])
            print(f"rose: {LABEL[tool]} · {name} hit its {info['kind'].replace('_', '-')} limit "
                  f"(until {clock(until)}).", file=sys.stderr)
            plan = switch_targets(tool, name, tried, override) if sid else []
            if not plan:
                why = 'no other account is available' if sid and next_targets(tool, name, tried) == [] \
                    else 'switching is off for this account'
                print(f'rose: {why}. Chat saved: rose resume {label} [--to ACCOUNT]', file=sys.stderr)
                return rc
            target, how_mode = plan[0]
            how = lambda a: 'moves this chat' if a[0] == tool else 'new chat with this conversation handed over'
            if how_mode == 'ask':
                if not sys.stdin.isatty():
                    print(f'rose: chat saved: rose resume {label}', file=sys.stderr)  # nobody to ask
                    return rc
                if len(plan) > 1:
                    target = pick('Continue on which account?',
                                  [(o, f'{spec(o):<18} ({how(o)})') for o, _ in plan],
                                  enter_first=True, cancel_word='stay here, keep the chat')
                elif not ask(f'Continue on {spec(target)} ({how(target)})?', default=True):
                    target = None
                if not target:
                    print(f'rose: chat saved: rose resume {label}', file=sys.stderr)
                    return rc
            event, reason = ('auto_switched' if how_mode == 'auto' else 'switched'), 'limit'

        if target[0] == tool:
            row = next((r for r in sessions(tool, name) if r['id'] == sid), None)
            if not row:
                print(f'rose: could not find the saved chat {sid}', file=sys.stderr)
                return rc
            move(row, target[1], quiet=True, event=event)
            print(f'rose: moved chat {label} {name} → {target[1]}; continuing.', file=sys.stderr)
            name, resume, args, chat_name = target[1], sid, [], None
            prompt = CONTINUE_PROMPT if reason == 'limit' else None
        else:
            prompt = handoff_prompt((tool, name), path, cwd, reason=reason)
            old_name = chat_names().get(f'{tool}:{sid}')
            if old_name:
                set_chat_name(tool, sid, None)   # the name follows the conversation
            record('handoff', tool=target[0], account=target[1], previous=f'{tool}:{name}', session=sid,
                   cwd=cwd, title=old_name)
            print(f'rose: handing chat {label} over from {spec((tool, name))} to {spec(target)}.', file=sys.stderr)
            tool, name, resume, args, chat_name = target[0], target[1], None, [], old_name
        if reason == 'limit':
            tried.add(target)
        else:
            tried = {target}


def run_tool(tool, argv):
    p = argparse.ArgumentParser(prog=f'rose {tool}', add_help=False)
    p.add_argument('-a', '--account')
    p.add_argument('--failover', choices=MODES)
    p.add_argument('-n', '--name', dest='chat_name', help='name the new chat, e.g. excel-calcs')
    p.add_argument('--rose-help', action='store_true')
    known, rest = p.parse_known_args(argv)
    if known.rose_help:
        print(f'rose {tool} [-a ACCOUNT] [-n CHAT-NAME] [--failover off|ask|auto] [native {tool} args...]')
        return 0
    name = choose_account(tool, known.account)
    passthrough = (rest and rest[0] in PASSTHROUGH[tool]) or NONINTERACTIVE_FLAGS[tool] & set(rest)
    plan = switch_targets(tool, name, (), known.failover) if not known.account and not passthrough and \
        over_threshold(tool, name) else []
    if plan:
        target, how_mode = plan[0]
        if not over_threshold(*target):
            msg = f'{name} is at {max_used(name):.0f}% (threshold {threshold(tool)}%)'
            if how_mode == 'auto' or \
                    (sys.stdin.isatty() and ask(f'{msg}. Start on {spec(target)} instead?', default=True)):
                print(f'rose: {msg}; starting on {spec(target)}.', file=sys.stderr)
                bare = rest if len(rest) == 1 and not rest[0].startswith('-') else []
                if target[0] != tool and rest and not bare:
                    print(f'rose: {tool} options are not passed to {target[0]}', file=sys.stderr)
                return launch(target[0], target[1], rest if target[0] == tool else bare,
                              mode=known.failover, chat_name=known.chat_name)
    if (rest and rest[0] in PASSTHROUGH[tool]) or NONINTERACTIVE_FLAGS[tool] & set(rest) or \
            (tool == 'codex' and rest == ['resume']):
        if tool == 'codex' and rest[:1] in (['resume'], ['fork']):   # interactive pickers: no shared server
            rest = rest[:1] + no_daemon(rest) + rest[1:]
        os.execvpe(BINARY[tool], [BINARY[tool]] + rest, environment(tool, name))
    if tool == 'codex' and rest[:1] == ['resume'] and len(rest) > 1:
        return resume_cmd([rest[1], '--tool', 'codex'] + (['--failover', known.failover] if known.failover else []))
    return launch(tool, name, rest, mode=known.failover, chat_name=known.chat_name)


# ---------------------------------------------------------------- commands

def cmd_add(a):
    if not NAME.match(a.name):
        raise Error('account names: letters, digits, - and _')
    d = account_dir(a.tool, a.name)
    if d.exists() or d.is_symlink():
        raise Error(f'{a.tool}:{a.name} already exists')
    private_dir(d.parent)
    if a.adopt:
        target = Path(a.adopt).expanduser().resolve()
        if not target.is_dir():
            raise Error(f'{target} is not a directory')
        d.symlink_to(target)
        print(f'{LABEL[a.tool]} account {a.name} uses existing home {target}')
    else:
        private_dir(d)
        print(f'{LABEL[a.tool]} account {a.name} at {d}')
        link_shared(a.tool, a.name)
    ef = env_file(a.tool, a.name)
    if not ef.exists():
        private_dir(ef.parent)
        ef.write_text('# Extra environment for this account (KEY=value), applied by rose.\n'
                      '# e.g. an org API key or Bedrock: ANTHROPIC_API_KEY=...  CLAUDE_CODE_USE_BEDROCK=1\n')
        ef.chmod(0o600)
    record('added', tool=a.tool, account=a.name)
    for w in shared_warnings() if a.tool == 'claude' else []:
        print('WARNING: ' + w)
    if not a.no_login and not has_login(a.tool, a.name):
        return cmd_login(argparse.Namespace(tool=a.tool, name=a.name, device=a.device))
    return 0


def headless():
    """No local browser: SSH session, or Linux without a display."""
    if os.environ.get('SSH_CONNECTION') or os.environ.get('SSH_TTY'):
        return True
    return sys.platform != 'darwin' and not (os.environ.get('DISPLAY') or os.environ.get('WAYLAND_DISPLAY'))


def cmd_login(a):
    tool, name = parse_spec(a.name, a.tool)
    cmd = [BINARY[tool], 'auth', 'login'] if tool == 'claude' else [BINARY[tool], 'login']
    device = getattr(a, 'device', None)
    if tool == 'codex' and (device or (device is None and headless())):
        cmd.append('--device-auth')  # browser on another device: open the URL, enter the code
        print('No local browser here, so this uses a device code: open the link on any device and enter the code.')
    print(f'Signing in {LABEL[tool]} · {name}. Choose the account you want for "{name}" in the browser.')
    return subprocess.call(cmd, env=environment(tool, name))


def cmd_logout(a):
    tool, name = parse_spec(a.name, a.tool)
    cmd = [BINARY[tool], 'auth', 'logout'] if tool == 'claude' else [BINARY[tool], 'logout']
    return subprocess.call(cmd, env=environment(tool, name))


def cmd_rm(a):
    tool, name = parse_spec(a.name, a.tool)
    d = account_dir(tool, name)
    if d.is_symlink():
        if ask(f'Forget adopted account {tool}:{name}? (its home {d.resolve()} is kept)'):
            d.unlink()
        return 0
    if not ask(f'Delete {tool}:{name} including its login and chat history at {d}?'):
        raise Error('aborted')
    shutil.rmtree(d)
    with contextlib.suppress(OSError):
        env_file(tool, name).unlink()
    record('removed', tool=tool, account=name)
    print('removed (shared config untouched)')
    return 0


def cmd_status(a):
    s = settings()
    cool = cooldowns()
    rows = sessions()
    running = running_records()
    for w in shared_warnings():
        print('WARNING: ' + w + '\n')
    if chain():
        print('Order: ' + ' → '.join(spec(x) + (' ⚠' if over_threshold(*x) else '') for x in chain()) +
              (f"   (Claude threshold {threshold('claude')}%)" if threshold('claude') else ''))
        print()
    for tool in TOOLS:
        accs = accounts(tool)
        print(f"{LABEL[tool]}  (failover: {failover_label(tool)}"
              + (f", shell: {active_in_shell(tool)}" if active_in_shell(tool) else '')
              + (f", pinned here: {pinned(tool)}" if pinned(tool) else '') + ')')
        if not accs:
            print(f'  no accounts (rose add {tool} <name>)')
        for t, n in accs:
            auth, email = identity(t, n) if not a.fast else ('login' if has_login(t, n) else 'no login', '')
            c = cool.get(f'{t}:{n}')
            chats = sum(1 for r in rows if r['tool'] == t and r['account'] == n)
            live = sum(1 for r in running if r['tool'] == t and r['account'] == n)
            bits = [auth] + ([email] if email else []) + [f'{chats} chats'] + \
                   ([f'{live} open'] if live else []) + ([f"limit until {clock(c['until'])}"] if c else [])
            print(f'  {n:<14} ' + ' · '.join(bits))
            print(f"  {'':<14} {usage_text(t, n)}")
        print()
    return 0


def cmd_sessions(a):
    rows = sessions(a.tool, a.account)
    if not a.everywhere:  # prefer this directory's chats when there are any
        here = str(Path.cwd().resolve())
        rows = [r for r in rows if r['cwd'] == here] or rows
    rows = rows[:a.limit]
    if a.json:
        print(json.dumps(rows, indent=2))
        return 0
    if not rows:
        print('no chats')
    for r in rows:
        proj = r['cwd'].replace(str(Path.home()), '~')
        print(f"{ref(r):<16.16} {r['tool']:<6} {r['account']:<10} {ago(r['modified']):>8}  "
              f"{'● ' if r['open'] else ''}{r['title']}   [{proj}]")
    return 0


def pick_session(tool=None):
    rows = sessions(tool)[:25]
    opts = [(r, f"{ref(r):<16.16} {r['tool']:<6} {r['account']:<10} {ago(r['modified']):>8}  {r['title']}  "
                f"[{r['cwd'].replace(str(Path.home()), '~')}]") for r in rows]
    if not opts:
        raise Error('no chats yet')
    row = pick('Chat:', opts)
    if not row:
        raise Error('no chat chosen')
    return row


def resume_cmd(argv):
    p = argparse.ArgumentParser(prog='rose resume')
    p.add_argument('id', nargs='?')
    p.add_argument('--to', help='move to this account first')
    p.add_argument('--tool', choices=TOOLS)
    p.add_argument('--last', action='store_true', help='most recent chat in this directory')
    p.add_argument('--failover', choices=MODES)
    p.add_argument('--here', action='store_true', help='resume in the current directory')
    a = p.parse_args(argv)
    if a.last:
        here = str(Path.cwd().resolve())
        rows = [r for r in sessions(a.tool) if r['cwd'] == here] or sessions(a.tool)
        if not rows:
            raise Error('no chats yet')
        row = rows[0]
    else:
        row = find_session(a.id, a.tool) if a.id else pick_session(a.tool)
    if a.to:
        target = parse_spec(a.to, row['tool'])[1]
        if target != row['account']:
            move(row, target)
            row = dict(row, account=target)
    cwd = Path.cwd() if a.here or not Path(row['cwd']).is_dir() else row['cwd']
    src = (row['tool'], row['account'])
    plan = switch_targets(*src, (), a.failover) if not a.to and (over_threshold(*src) or not usable(*src)) else []
    if plan:
        target, how_mode = plan[0]
        why = (f"is at {max_used(src[1]):.0f}% (threshold {threshold(src[0])}%)" if over_threshold(*src)
               else 'is at its limit')
        if target and (how_mode == 'auto' or
                       (sys.stdin.isatty() and ask(f'{spec(src)} {why}. Continue on {spec(target)}?', default=True))):
            print(f'rose: {spec(src)} {why}; continuing on {spec(target)}.', file=sys.stderr)
            if target[0] == row['tool']:
                move(row, target[1], quiet=True, event='threshold_switched')
                return launch(target[0], target[1], [], cwd=cwd, resume=row['id'], mode=a.failover)
            name = row.get('name')
            if name:
                set_chat_name(row['tool'], row['id'], None)
            record('handoff', tool=target[0], account=target[1], previous=f'{src[0]}:{src[1]}',
                   session=row['id'], cwd=str(cwd), title=name)
            return launch(target[0], target[1], [], cwd=cwd, mode=a.failover, chat_name=name,
                          prompt=handoff_prompt(src, Path(row['path']), cwd))
    return launch(row['tool'], row['account'], [], cwd=cwd, resume=row['id'], mode=a.failover)


