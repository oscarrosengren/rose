def cmd_order(a):
    s = settings()
    specs = list(a.specs)
    if specs and specs[0] in TOOLS and ':' not in specs[0]:          # old form: rose order claude a b
        specs = [f'{specs[0]}:{n}' for n in specs[1:]]
    if specs == ['clear']:
        s.pop('chain', None)
        save_settings(s)
    elif specs:
        resolved = []
        for x in specs:
