    if a.value:
        if a.value == 'off':
            s.setdefault('threshold', {}).pop('claude', None)
        else:
            v = int(a.value.rstrip('%'))
            if not 1 <= v <= 100:
                raise Error('threshold is a percentage, 1-100')
            s.setdefault('threshold', {})['claude'] = v
        save_settings(s)
    v = s.get('threshold', {}).get('claude')
    print(f"Claude threshold: {str(v) + '%' if v else 'off'}")
    print('An account at or above it is skipped for new chats, resumes and failover (5-hour or weekly usage).')
    return 0


