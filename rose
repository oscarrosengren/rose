def menu():
    while True:
        cool = cooldowns()
        s = settings()
        print('\nrose')
        for tool in TOOLS:
            names = [f"{n}{' (limit)' if f'{tool}:{n}' in cool else ''}" for _, n in accounts(tool)]
            print(f"  {LABEL[tool]:<7} {', '.join(names) or '-'}   failover: {s['failover'].get(tool, 'ask')}")
        choice = pick('', [('claude', 'New Claude chat'), ('codex', 'New Codex chat'), ('resume', 'Resume a chat'),
                           ('move', 'Move a chat to another account'), ('status', 'Status'),
                           ('failover', 'Change failover mode'), ('add', 'Add an account')])
        if choice is None:
            return 0
        try:
            if choice in TOOLS:
                return launch(choice, choose_account(choice), [])
            if choice == 'resume':
                return resume_cmd([])
            if choice == 'move':
                cmd_move(argparse.Namespace(id=None, to=None, tool=None))
            elif choice == 'status':
                cmd_status(argparse.Namespace(fast=False))
            elif choice == 'failover':
                tool = pick('Tool:', [(t, LABEL[t]) for t in TOOLS])
                mode = tool and pick('Mode:', [(m, m) for m in MODES])
                if mode:
                    cmd_failover(argparse.Namespace(tool=tool, mode=mode))
            elif choice == 'add':
                tool = pick('Tool:', [(t, LABEL[t]) for t in TOOLS])
                if tool:
                    name = input('  name (e.g. work, personal): ').strip()
                    cmd_add(argparse.Namespace(tool=tool, name=name, adopt=None, no_login=False, device=None))
        except Error as e:
            print('rose: ' + str(e))


def parser():
    p = argparse.ArgumentParser(prog='rose', description='Switch Claude Code and Codex between accounts.',
                                epilog='rose claude/codex [-a ACCOUNT] [--failover MODE] [native args...] '
                                       'starts the native TUI under an account.')
    p.add_argument('--version', action='version', version='rose ' + VERSION)
    sub = p.add_subparsers(dest='cmd')
    t = dict(choices=TOOLS)

    s = sub.add_parser('add', help='add an account and sign in')
    s.add_argument('tool', **t)
    s.add_argument('name')
    s.add_argument('--adopt', metavar='DIR', help='use an existing home (e.g. ~/.codex) instead of a new one')
    s.add_argument('--no-login', action='store_true')
    s.add_argument('--device', action='store_true', default=None, help='Codex: sign in with a device code')
    s.set_defaults(fn=cmd_add)
    s = sub.add_parser('login', help='sign in (Codex uses a device code automatically over SSH/headless)')
    s.add_argument('tool', nargs='?', **t)
    s.add_argument('name')
    s.add_argument('--device', dest='device', action='store_true', default=None, help='force device-code sign-in')
    s.add_argument('--browser', dest='device', action='store_false', help='force the normal browser sign-in')
    s.set_defaults(fn=cmd_login)
    for name, fn, h in (('logout', cmd_logout, 'sign out'),
                        ('rm', cmd_rm, 'delete an account'), ('env', cmd_env, "print the account's env file")):
        s = sub.add_parser(name, help=h)
        s.add_argument('tool', nargs='?', **t)
        s.add_argument('name')
        s.set_defaults(fn=fn)
    s = sub.add_parser('status', aliases=['list', 'ls', 'accounts'], help='accounts, logins, limits')
    s.add_argument('--fast', action='store_true', help='skip asking the tools for login details')
    s.set_defaults(fn=cmd_status)
    s = sub.add_parser('sessions', aliases=['chats'], help='chats across all accounts')
    s.add_argument('--tool', **t)
    s.add_argument('--account')
    s.add_argument('-n', '--limit', type=int, default=20)
    s.add_argument('--all', '--everywhere', dest='everywhere', action='store_true', help='not just this directory')
    s.add_argument('--json', action='store_true')
    s.set_defaults(fn=cmd_sessions)
    s = sub.add_parser('name', aliases=['rename'], help='name a chat: rose name CHAT excel-calcs')
    s.add_argument('chat', nargs='?', help='chat id prefix or current name (omit for a picker)')
    s.add_argument('new', nargs='?')
    s.add_argument('--tool', **t)
    s.add_argument('--clear', action='store_true')
    s.add_argument('--force', action='store_true', help='take the name from another chat')
    s.set_defaults(fn=cmd_name)
    s = sub.add_parser('move', aliases=['switch'], help='move a chat to another account')
    s.add_argument('id', nargs='?')
    s.add_argument('--to')
    s.add_argument('--tool', **t)
    s.set_defaults(fn=cmd_move)
    s = sub.add_parser('failover', help='off | ask | auto when an account hits its limit')
    s.add_argument('tool', nargs='?', **t)
    s.add_argument('mode', nargs='?', choices=MODES)
    s.set_defaults(fn=cmd_failover)
    s = sub.add_parser('default', help='account to use when nothing else picks one')
    s.add_argument('tool', **t)
    s.add_argument('name', nargs='?')
    s.add_argument('--clear', action='store_true')
    s.set_defaults(fn=cmd_default)
    s = sub.add_parser('order', help='account order across tools: rose order claude:personal codex:main ...')
    s.add_argument('specs', nargs='*', metavar='TOOL:NAME')
    s.set_defaults(fn=cmd_order)
    s = sub.add_parser('defaults', help='model/effort/permission defaults applied at launch')
    s.add_argument('tool', **t)
    s.add_argument('--model')
    s.add_argument('--effort')
    s.add_argument('--yolo', dest='yolo', action='store_true', default=None)
    s.add_argument('--no-yolo', dest='yolo', action='store_false')
    s.add_argument('--clear', action='store_true')
    s.set_defaults(fn=cmd_defaults)
    s = sub.add_parser('threshold', help='skip Claude accounts at/above N%% usage: rose threshold 95 | off')
    s.add_argument('value', nargs='?')
    s.set_defaults(fn=cmd_threshold)
    sub.add_parser('chat', help='new chat on the first available account in your order')
    s = sub.add_parser('usage', help='live Claude plan usage per account; install/uninstall recording')
    s.add_argument('action', nargs='?', choices=('install', 'uninstall'))
    s.set_defaults(fn=cmd_usage)
    s = sub.add_parser('activity', help='opens, limits, moves')
    s.add_argument('-n', '--limit', type=int, default=30)
    s.set_defaults(fn=cmd_activity)
    s = sub.add_parser('sync', help='re-link shared config into accounts')
    s.add_argument('tool', nargs='?', **t)
    s.set_defaults(fn=cmd_sync)
    s = sub.add_parser('pin', help='write .rose: this directory uses an account')
    s.add_argument('tool', nargs='?', **t)
    s.add_argument('name')
    s.set_defaults(fn=cmd_pin)
    s = sub.add_parser('init', help='print shell integration')
    s.add_argument('shell', nargs='?', choices=('bash', 'zsh'), default='bash')
    s.set_defaults(fn=cmd_init)
    sub.add_parser('resume', help='resume any chat (picker, id prefix, --last, --to ACCOUNT)')
    sub.add_parser('claude', help='start Claude Code under an account')
    sub.add_parser('codex', help='start Codex under an account')
    sub.add_parser('use', help='switch this shell: rose use [claude|codex] NAME  (needs rose init)')
    sub.add_parser('off', help='back to the default ~/.claude / ~/.codex in this shell')
    return p


def main(argv):
    try:
        if not argv:
            return menu() if sys.stdin.isatty() else parser().print_help()
        c = argv[0]
        if c in TOOLS:
            return run_tool(c, argv[1:])
        if c == 'resume':
            return resume_cmd(argv[1:])
        if c == 'chat':
            return cmd_chat(argv[1:])
        if c == 'statusline':
            return cmd_statusline(argv[1:])
        if c == '__emit':
            return emit(argv[1:])
        if c in ('use', 'off'):
            raise Error(f"'rose {c}' changes your shell; add to ~/.bashrc: eval \"$(rose init bash)\"")
        a = parser().parse_args(argv)
        return a.fn(a)
    except Error as e:
        print('rose: ' + str(e), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print()
        return 130


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]) or 0)
