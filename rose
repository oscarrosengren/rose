def emit(argv):
    """Shell code for the integration function to eval."""
    out = []
    sub = argv[0] if argv else ''
    if sub == 'use':
        if len(argv) < 2:
            raise Error('usage: rose use [claude|codex] NAME')
        tool, name = (argv[1], argv[2]) if argv[1] in TOOLS and len(argv) > 2 else (None, argv[1])
        tool, name = parse_spec(name, tool)
        out += [f'unset {v};' for v in AUTH_ENV[tool]]
        value = home_value(tool, name)
        out.append(f'export {HOME_VAR[tool]}={shlex.quote(value)};' if value else f'unset {HOME_VAR[tool]};')
        out.append(f'export ROSE_{tool.upper()}={shlex.quote(name)};')
        for k, v in load_env_file(env_file(tool, name)).items():
            if re.match(r'^[A-Za-z_][A-Za-z0-9_]*$', k):
                out.append(f'export {k}={shlex.quote(v)};')
        print(f'rose: {LABEL[tool]} → {name}', file=sys.stderr)
    elif sub == 'off':
        for t in ([argv[1]] if len(argv) > 1 and argv[1] in TOOLS else TOOLS):
            out.append(f'unset {HOME_VAR[t]} ROSE_{t.upper()};')
    elif sub == 'auto':
        for t in TOOLS:
            n = pinned(t)
            if n and (t, n) in accounts(t) and os.environ.get('ROSE_' + t.upper()) != n:
                out.append(f'eval "$(command rose __emit use {t} {shlex.quote(n)})";')
    print('\n'.join(out))
    return 0


