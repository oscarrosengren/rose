class GitError(Error):
    pass


def friendly_git_error(raw):
    """Plain-language explanation of a failed git step; rose always keeps the working version."""
    t = raw.lower()
    keep = f'rose stays on version {VERSION}, which keeps working.'
    if any(k in t for k in ('could not resolve host', 'unable to access', 'network is unreachable', 'timed out',
                            'connection refused', 'failed to connect', 'could not connect', 'temporary failure')):
        return f"Couldn't reach GitHub (is the internet connected?). {keep} Try again later."
    if any(k in t for k in ('authentication failed', 'could not read username', 'permission denied',
                            'repository not found', 'access denied')):
        return f"GitHub refused the download (the project may have moved or become private). {keep}"
    if 'does not appear to be a git repository' in t or 'no such remote' in t or 'no upstream' in t:
        return f"rose can't find where to download updates from. {keep} Reinstall with:\n  {INSTALL_CMD}"
    if 'not possible to fast-forward' in t or 'diverg' in t or 'not possible because you have unmerged' in t:
        return (f'This copy of rose has its own changes that are not on GitHub, so it cannot update by itself. '
                f'{keep} (Developers: push or rebase your commits.)')
    return f'Updating failed. {keep}\nDetails: ' + raw.strip()[-400:]


def git(*args, check=True):
    r = subprocess.run(['git', '-C', str(APP), *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        raise GitError(friendly_git_error((r.stderr or '') + (r.stdout or '')))
    return r.stdout.strip()


def update_state():
    return read_json(ROOT / 'update.json', {})


def save_update_state(**kw):
    st = update_state()
    st.update(kw)
    atomic_json(ROOT / 'update.json', st)


def pending_commits():
    if not (APP / '.git').exists():
        return []
    r = subprocess.run(['git', '-C', str(APP), 'log', '--oneline', 'HEAD..@{u}'], capture_output=True, text=True)
    return r.stdout.strip().splitlines() if r.returncode == 0 else []


def background_check():
    """At most every 6 h: fetch in the background (never blocks); the next run reports or applies it."""
    policy = settings().get('update_policy', 'notify')
    if policy == 'off' or not (APP / '.git').exists():
        return
    st = update_state()
    if time.time() - st.get('checked', 0) > 6 * 3600:
        save_update_state(checked=time.time())
        with contextlib.suppress(OSError):
            subprocess.Popen(['git', '-C', str(APP), 'fetch', '-q'], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL, start_new_session=True)
    new = pending_commits()
    if not new:
        return
    if policy == 'auto':
        try:
            do_update(quiet=True)
            print(f'rose: updated to version {installed_version()} in the background.', file=sys.stderr)
            return
        except Error as e:
            if time.time() - st.get('error_shown', 0) > 24 * 3600:   # say it at most once a day
                save_update_state(error_shown=time.time())
                print(f"rose: couldn't update automatically. {e}", file=sys.stderr)
            return
    print(f'rose: a new version is available. Install it with: rose update', file=sys.stderr)


def installed_version():
    r = subprocess.run([sys.executable, '-I', str(SELF), '--version'], capture_output=True, text=True)
    return r.stdout.strip().replace('rose ', '') or '?'


def do_update(quiet=False, force=False):
    if not (APP / '.git').exists():
        raise Error(f"This copy of rose wasn't installed with the installer, so it can't update itself. "
                    f"Reinstall (your accounts and settings are kept):\n  {INSTALL_CMD}")
    dirty = [ln for ln in git('status', '--porcelain').splitlines() if not ln.startswith('??')]
    if dirty:
        if not force:
            raise Error("Some of rose's own files were changed on this computer, so rose won't overwrite them. "
                        "To save those changes aside and update anyway: rose update --force")
        git('stash', 'push', '-q', '-m', 'rose update ' + time.strftime('%Y-%m-%d %H:%M'))
        if not quiet:
            print(f'Saved your changes aside (see: git -C {APP} stash list).')
    git('fetch', '-q')
    new = pending_commits()
    if not new:
        if not quiet:
            print(f'rose {VERSION} is up to date.')
        return False
    previous = git('rev-parse', 'HEAD')
    git('merge', '--ff-only', '-q', '@{u}')
    check = subprocess.run([sys.executable, '-I', str(SELF), '--version'], capture_output=True, text=True)
    if check.returncode != 0:
        git('reset', '--hard', '-q', previous)
        raise Error(f'The new version did not start correctly, so rose stayed on version {VERSION}. '
                    f'Nothing else changed. Try again later.')
    save_update_state(previous=previous, updated=time.time())
    with contextlib.suppress(Exception):   # keep the Claude hook/status line pointing at this checkout
        if is_rose_cmd((read_json(claude_settings_file(), {}).get('statusLine') or {}).get('command'), ' statusline'):
            subprocess.run([sys.executable, str(SELF), 'setup'], capture_output=True)
    if not quiet:
        print(f'Updated rose from {VERSION} to {check.stdout.strip().replace("rose ", "")}.')
        for line in new:
            print('  ' + line)
        print('Your accounts, chats and settings are unchanged. Open chats keep running and pick up the')
        print('new version the next time they restart.')
    return True


def cmd_update(a):
    if a.policy:
        s = settings()
        if not (a.if_unset and s.get('update_policy')):
            s['update_policy'] = a.policy
            save_settings(s)
        print(f"updates: {s.get('update_policy')}  (auto = install by themselves; notify = tell me; off)")
        return 0
    if a.rollback:
        prev = update_state().get('previous')
        if not prev:
            raise Error('There is no earlier version to go back to.')
        git('reset', '--hard', '-q', prev)
        s = settings()
        s['update_policy'] = 'notify'
        save_settings(s)
        print(f'Went back to the previous version ({installed_version()}). Automatic updates are paused '
              f'(notify); turn them back on with: rose update --policy auto')
        return 0
    if a.check:
        git('fetch', '-q')
        new = pending_commits()
        print(f'{len(new)} update(s) available' + (':' if new else '.'))
        for line in new:
            print('  ' + line)
        return 0
    do_update(force=a.force)
    return 0


