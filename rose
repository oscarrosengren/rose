def cmd_failover(argv):
    """rose failover                          show
       rose failover MODE | all MODE          every switch
       rose failover claude|codex MODE        switches away from that tool (simple mode)
       rose failover FROM TO MODE             one switch, e.g. personal codex auto (turns on advanced)
       rose failover FROM TO default          remove that rule
       rose failover advanced on|off"""
    s = settings()
    a = list(argv)
    if a in (['-h'], ['--help']):
        print(cmd_failover.__doc__)
        return 0
    if len(a) == 2 and a[0] == 'advanced' and a[1] in ('on', 'off'):
        s['failover_advanced'] = a[1] == 'on'
    elif len(a) == 1 and a[0] in MODES or len(a) == 2 and a[0] == 'all' and a[1] in MODES:
        mode = a[-1]
        s['failover'] = {t: mode for t in TOOLS}
        if s.get('failover_advanced'):
            s['failover_rules'] = {k: mode for k in s.get('failover_rules', {})}
    elif len(a) == 2 and a[0] in TOOLS and a[1] in MODES:
        s['failover'][a[0]] = a[1]
    elif len(a) == 3 and (a[2] in MODES or a[2] == 'default'):
        src, dst = resolve_account(a[0]), resolve_account(a[1])
        if src == dst:
            raise Error('pick two different accounts')
        rules = s.setdefault('failover_rules', {})
        if a[2] == 'default':
            rules.pop(rule_key(src, dst), None)
        else:
            rules[rule_key(src, dst)] = a[2]
            s['failover_advanced'] = True
    elif a:
        raise Error('usage: rose failover [all|claude|codex] ask|auto|off  ·  rose failover FROM TO ask|auto|off|default'
                    '  ·  rose failover advanced on|off')
    if a:
        save_settings(s)
    return show_failover()


