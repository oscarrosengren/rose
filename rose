        s['chain'] = resolved
        save_settings(s)
    order = chain()
    print('Order: ' + (' → '.join(spec(x) for x in order) if order else '(not set; failover stays within a tool)'))
    if order:
        print('Used by `rose chat`, by failover, and to skip accounts over the threshold.')
